"""一键启动：在 PyCharm 里右键“运行”本文件即可。

- 同时拉起后端 (uvicorn, 8000) 和前端 (vite, 5173)，日志都打印在这个窗口。
- 点 PyCharm 的红色停止按钮（或按 Ctrl+C），两个服务会一起关闭。
- 原理：把两个子进程放进一个带 KILL_ON_JOB_CLOSE 的 Windows Job，
  主进程一旦结束（含被强杀），系统自动杀掉整棵子进程树，不留孤儿。
"""
from __future__ import annotations

import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

# ROOT = Path(__file__).resolve().parent
# VENV_PYTHON = ROOT / "Global-CS-Paper-Awards-main" / "Scripts" / "python.exe"
# FRONTEND = ROOT / "frontend"
ROOT = Path(__file__).resolve().parent
# 真实虚拟环境目录名：Global-CS-Paper-Awards-main
VENV_PYTHON = ROOT / "Global-CS-Paper-Awards-main" / "Scripts" / "python.exe"
FRONTEND = ROOT / "frontend"


children: list[subprocess.Popen] = []


# ---------- Windows Job 对象：主进程死 -> 子进程死 ----------
if sys.platform == "win32":
    import ctypes
    from ctypes import wintypes

    class _IO_COUNTER(ctypes.Structure):
        _fields_ = [("ReadOperationCount", ctypes.c_ulonglong),
                    ("WriteOperationCount", ctypes.c_ulonglong),
                    ("OtherOperationCount", ctypes.c_ulonglong),
                    ("ReadTransferCount", ctypes.c_ulonglong),
                    ("WriteTransferCount", ctypes.c_ulonglong),
                    ("OtherTransferCount", ctypes.c_ulonglong)]

    class _BASIC(ctypes.Structure):
        _fields_ = [("PerProcessUserTimeLimit", ctypes.c_int64),
                    ("PerJobUserTimeLimit", ctypes.c_int64),
                    ("LimitFlags", wintypes.DWORD),
                    ("MinimumWorkingSetSize", ctypes.c_size_t),
                    ("MaximumWorkingSetSize", ctypes.c_size_t),
                    ("ActiveProcessLimit", wintypes.DWORD),
                    ("Affinity", ctypes.c_size_t),
                    ("PriorityClass", wintypes.DWORD),
                    ("SchedulingClass", wintypes.DWORD)]

    class _EXTENDED(ctypes.Structure):
        _fields_ = [("BasicLimitInformation", _BASIC),
                    ("IoInfo", _IO_COUNTER),
                    ("ProcessMemoryLimit", ctypes.c_size_t),
                    ("JobMemoryLimit", ctypes.c_size_t),
                    ("PeakProcessMemoryUsed", ctypes.c_size_t),
                    ("PeakJobMemoryUsed", ctypes.c_size_t)]

    _kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    _JOB_EXTENDED_INFO = 9
    _JOB_KILL_ON_JOB_CLOSE = 0x00002000

    _job = _kernel32.CreateJobObjectW(None, None)
    _info = _EXTENDED()
    _info.BasicLimitInformation.LimitFlags = _JOB_KILL_ON_JOB_CLOSE
    _kernel32.SetInformationJobObject(
        _job, _JOB_EXTENDED_INFO, ctypes.byref(_info), ctypes.sizeof(_info))

    def _assign(p: subprocess.Popen):
        try:
            _kernel32.AssignProcessToJobObject(_job, int(p._handle))
        except Exception:
            pass  # 已在其他 Job 中时忽略，下面的 taskkill 兜底
else:
    def _assign(p: subprocess.Popen):  # type: ignore
        pass


def stop_all():
    for p in children:
        if p.poll() is None:
            try:
                subprocess.run(["taskkill", "/PID", str(p.pid), "/T", "/F"],
                               capture_output=True)
            except Exception:
                pass
    children.clear()


def on_signal(*_):
    print("\n[run_all] 正在停止后端和前端...")
    stop_all()
    sys.exit(0)


signal.signal(signal.SIGINT, on_signal)
signal.signal(signal.SIGTERM, on_signal)


def main():
    if not VENV_PYTHON.exists():
        sys.exit(f"找不到虚拟环境 Python：{VENV_PYTHON}")

    # 后端：直接用 venv 的 python 跑 uvicorn（不经 shell）
    backend = subprocess.Popen(
        [str(VENV_PYTHON), "-m", "uvicorn", "api:app", "--host", "127.0.0.1", "--port", "8000"],
        cwd=str(ROOT),
    )
    children.append(backend)
    _assign(backend)

    # 等后端真正就绪再打印提示，避免“页面先开、接口还没起来”导致空白
    import urllib.request
    ready = False
    for _ in range(40):
        if backend.poll() is not None:
            print("[run_all] 后端启动失败，请查看上方报错。")
            stop_all()
            sys.exit(1)
        try:
            urllib.request.urlopen("http://127.0.0.1:8000/api/meta", timeout=1)
            ready = True
            break
        except Exception:
            time.sleep(0.5)
    print(f"[run_all] 后端已就绪 -> http://127.0.0.1:8000  ({'OK' if ready else '等待超时'})")

    # 前端：直接用 node 跑 vite.js（不经 cmd，保证整棵树进 Job）
    node = shutil.which("node")
    vite_js = FRONTEND / "node_modules" / "vite" / "bin" / "vite.js"
    if not node or not vite_js.exists():
        print("[run_all] 警告：未找到 node 或 vite.js，前端未启动。"
              "请在 frontend 目录先 npm install。")
    else:
        frontend = subprocess.Popen([node, str(vite_js)], cwd=str(FRONTEND))
        children.append(frontend)
        _assign(frontend)
        print("[run_all] 前端已启动 -> http://localhost:5173")

    print("[run_all] 两个服务已启动。浏览器打开 http://localhost:5173")
    print("[run_all] 按 Ctrl+C 或 PyCharm 红色停止按钮可同时关闭。\n")

    try:
        while True:
            time.sleep(1)
            if backend.poll() is not None:
                print("[run_all] 后端退出了，自动结束。")
                break
            if children[1].poll() is not None if len(children) > 1 else False:
                print("[run_all] 前端退出了，自动结束。")
                break
    except KeyboardInterrupt:
        on_signal()
    finally:
        stop_all()


if __name__ == "__main__":
    main()
