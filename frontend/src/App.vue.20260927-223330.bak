<script setup>
import { ref, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import { Loading } from '@element-plus/icons-vue'
import { api, errMsg } from './api.js'
import SearchView from './views/SearchView.vue'
import CollectView from './views/CollectView.vue'
import ReviewView from './views/ReviewView.vue'
import CoverageView from './views/CoverageView.vue'

const active = ref('search')
const meta = ref(null)
const stats = ref(null)
const loading = ref(true)
const loadError = ref('')

async function boot() {
  loading.value = true
  loadError.value = ''
  // 后端可能刚启动，最多重试 6 次（每次 1 秒）
  for (let i = 0; i < 6; i++) {
    try {
      meta.value = await api.meta()
      const all = await api.search({ status: 'all' })
      const records = all.records
      stats.value = {
        conferences: meta.value.conferences.length,
        records: records.length,
        pending: records.filter(r => r.status === 'pending').length,
      }
      loading.value = false
      return
    } catch (e) {
      loadError.value = errMsg(e)
      await new Promise(r => setTimeout(r, 1000))
    }
  }
  loading.value = false
}

onMounted(boot)
</script>

<template>
  <el-container class="layout">
    <el-aside width="220px" class="aside">
      <h2 class="title">🏆 Global CS Paper Awards Agent</h2>
      <p class="subtitle">全球计算机顶级论文奖数据库</p>
      <el-menu v-model="active" class="menu" @select="(i) => (active = i)">
        <el-menu-item index="search">论文检索</el-menu-item>
        <el-menu-item index="collect">采集与导入</el-menu-item>
        <el-menu-item index="review">记录核验</el-menu-item>
        <el-menu-item index="coverage">采集覆盖</el-menu-item>
      </el-menu>
    </el-aside>

    <el-main>
      <div v-if="loading" class="center-state">
        <el-icon class="is-loading" :size="24"><Loading /></el-icon>
        <p>正在连接后端…</p>
      </div>

      <div v-else-if="!meta" class="center-state">
        <p style="color:#b4443c">连不上后端：{{ loadError }}</p>
        <el-button type="primary" @click="boot">重试</el-button>
      </div>

      <template v-else>
        <div class="header">
          <h1>全球计算机顶级论文奖数据库</h1>
          <p class="sub">Best Paper &amp; Best Student Paper Awards in Top CS Venues</p>
          <el-row :gutter="16" class="metrics">
            <el-col :span="8"><el-statistic title="会议范围" :value="stats.conferences" /></el-col>
            <el-col :span="8"><el-statistic title="已记录奖项" :value="stats.records" /></el-col>
            <el-col :span="8"><el-statistic title="待核验" :value="stats.pending" /></el-col>
          </el-row>
        </div>

        <SearchView v-if="active === 'search'" :meta="meta" />
        <CollectView v-else-if="active === 'collect'" :meta="meta" />
        <ReviewView v-else-if="active === 'review'" :meta="meta" />
        <CoverageView v-else :meta="meta" />
      </template>
    </el-main>
  </el-container>
</template>

<style>
body { margin: 0; }
.layout { height: 100vh; }
.aside {
  background: #f1f5fa;
  border-right: 1px solid #e4e9f0;
  padding: 16px 8px;
  overflow-y: auto;
}
.title { font-size: 18px; margin: 0 8px; color: #152a45; }
.subtitle { font-size: 12px; color: #5a6b82; margin: 4px 8px 12px; }
.menu { border-right: none; background: transparent; }
.header { margin-bottom: 16px; }
.header h1 { font-size: 22px; margin: 0; color: #152a45; }
.header .sub { color: #8494a8; font-size: 13px; margin: 4px 0 12px; }
.metrics { margin-top: 8px; }
.center-state { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 60px 0; color: #5a6b82; }
</style>
